:"null"}],"default":null,"description":"The CF Standard Name of the variable","title":"Standard Name"},"science_keywords":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"description":"GCMD Science Keywords hierarchy","title":"Science Keywords"},"variable_type":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Type of variable (e.g., SCIENCE_VARIABLE, COORDINATE)","title":"Variable Type"},"variable_sub_type":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Sub-type of variable","title":"Variable Sub Type"},"sets":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"description":"Logical groupings for the variable","title":"Sets"},"measurement_identifiers":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"description":"Measurement context and provenance","title":"Measurement Identifiers"},"sampling_identifiers":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"description":"Sampling method context","title":"Sampling Identifiers"},"related_urls":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"description":"URLs specific to the variable","title":"Related Urls"}},"required":["concept_id"],"title":"VariableResult","type":"object"},"title":"Variables","type":"array"}},"required":["status"],"title":"GetVariablesOutput","type":"object"},"_meta":{"fastmcp":{"versions":["1.0.0"],"tags":[],"version":"1.0.0"}}}]}}

